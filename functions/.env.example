# Ces valeurs ne se mettent PAS ici en prod : utilise les secrets (voir README)
#   firebase functions:secrets:set ELEVENLABS_API_KEY
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# Pour l'émulateur local, copie ce fichier vers .env.local (PAS .env :
# la CLI injecterait .env au déploiement, en conflit avec les secrets).
ELEVENLABS_API_KEY=sk-xxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxx
